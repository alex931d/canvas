# Copy this file to .env.local and adjust if needed.

# Matches the database started by `docker compose up -d`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canvas

# ---------------------------------------------------------------------------
# Math checker (free). Any OpenAI-compatible API that accepts images works.
#
# Default: Google Gemini free tier. Create a free key (no card) in
# Google AI Studio: https://aistudio.google.com/apikey
# Note: on the free tier Google may use what you send to improve its products.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash

# Groq free plan (vision models: https://console.groq.com/docs/vision)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=qwen/qwen3.8-27b

# Ollama on your own machine: free and private, no key needed
#   ollama pull qwen3-vl:8b
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3-vl:8b

# ---------------------------------------------------------------------------
# Email: sign-up codes and password reset links. Any SMTP provider works
# (Resend, Postmark, Brevo, Amazon SES, Gmail with an app password, ...).
# Without SMTP_URL, emails are printed in the terminal running the app.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="canvas <hello@example.com>"

# CAPTCHA on sign-up, login and "forgot password": Cloudflare Turnstile (free).
# Create a widget (mode: Managed) in the Cloudflare dashboard under Turnstile,
# with your domain and localhost as hostnames. Without these keys the forms
# have no CAPTCHA.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Accounts (optional)
# Skip the Have I Been Pwned breached-password check, e.g. when offline.
# PASSWORD_BREACH_CHECK=off
# Drop the Secure flag from the session cookie when serving a production build
# over plain http:// on another machine (localhost is fine without this).
# INSECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Memberships: $1 a month through Stripe. See "Memberships" in README.md.
# Without these, nobody can start a membership; for local use you can give
# yourself one instead:  npm run membership -- grant you@example.com
#
# Secret key: https://dashboard.stripe.com/test/apikeys (sk_test_... while testing)
STRIPE_SECRET_KEY=
# Printed by `npm run stripe:setup`
STRIPE_PRICE_ID=
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or shown on your webhook endpoint in the Stripe Dashboard (production)
STRIPE_WEBHOOK_SECRET=
# Your site's public address (production): for Stripe to send people back to,
# and for links in emails
# APP_URL=https://canvas.example.com
