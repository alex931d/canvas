# Settings for canvas on your server (deploy/compose.yml).
# deploy/deploy.sh copies this to deploy/.env on its first run and fills in
# POSTGRES_PASSWORD; fill in the rest there. deploy/.env is never committed.

# ---------------------------------------------------------------------------
# Required

# Your domain. Point its DNS (an A record, and AAAA for IPv6) at this server
# first: Caddy gets the HTTPS certificate for it on the first start.
DOMAIN=canvas.example.com

# The database password (letters and digits only: it goes into a URL).
# Generated for you by deploy/deploy.sh. Don't change it once the database
# exists: Postgres keeps the one it was created with.
POSTGRES_PASSWORD=

# Encrypts two-factor sign-in keys (32 random bytes). Generated for you by
# deploy/deploy.sh. Keep it, and keep a copy somewhere safe: if it's lost or
# changed, codes from people's authenticator apps stop working.
ENCRYPTION_KEY=

# Stripe (memberships). README: Memberships > Going live. The webhook
# endpoint is https://<DOMAIN>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email (sign-up codes, password resets). Any SMTP provider.
SMTP_URL=
EMAIL_FROM="canvas <hello@canvas.example.com>"

# ---------------------------------------------------------------------------
# Recommended

# Shown on the terms of service page. Defaults to the address in EMAIL_FROM.
# CONTACT_EMAIL=hello@canvas.example.com

# Bot protection on sign-up and login (Cloudflare Turnstile, free).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# "Continue with Google" (README: Google sign-in). Redirect URI:
# https://<DOMAIN>/login/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The math checker (README: Turn on the math checker).
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Optional

# The site's address, if it isn't https://<DOMAIN>.
# APP_URL=https://canvas.example.com

# How often (seconds) the app looks for ended memberships whose server data is
# due for deletion, and sends their emails (README: Free and membership).
# STORAGE_SWEEP_SECONDS=3600

# Database backups: how often (hours) and how long they're kept (days).
# They're saved in deploy/backups on the server; copy them somewhere else too.
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=14
